{
  "name": "sdxl-kube",
  "type": "module",
  "private": true,
  "scripts": {
    "cdk:build": "cd cdk && bun run build",
    "cdk:synth": "cd cdk && node node_modules/aws-cdk/bin/cdk synth",
    "cdk:diff": "cd cdk && node node_modules/aws-cdk/bin/cdk diff",
    "cdk:deploy": "cd cdk && node node_modules/aws-cdk/bin/cdk deploy",
    "cdk:destroy": "cd cdk && node node_modules/aws-cdk/bin/cdk destroy"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
